<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_dummy"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <!-- BrowseFrameLayout serves as root of transition and manages switch between
         left and right-->
    <androidx.leanback.widget.BrowseFrameLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:id="@+id/browse_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Backdrop with rows overlapping on top -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Backdrop - full screen, behind rows -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/backdrop_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="visible"
                    android:contentDescription="@string/browse_backdrop" />

                <!-- Gradient overlay to blend backdrop with rows (bottom) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/backdrop_bottom_gradient" />

                <!-- Left-side gradient overlay for backdrop info text readability -->
                <View
                    android:layout_width="500dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/backdrop_left_gradient" />

                <!-- TMDB Movie Info Overlay (Title and Description) - Added programmatically -->
                <FrameLayout
                    android:id="@+id/backdrop_info_overlay_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Rows container - positioned to overlap backdrop, elevated to be on top -->
            <androidx.leanback.widget.BrowseRowsFrameLayout
                android:id="@+id/browse_container_dock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:elevation="4dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <androidx.leanback.widget.ScaleFrameLayout
                    android:id="@+id/scale_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

            </androidx.leanback.widget.BrowseRowsFrameLayout>

        </FrameLayout>

        <!-- Headers dock - hidden, replaced by custom navigation buttons -->
        <FrameLayout
            android:id="@+id/browse_headers_dock"
            android:layout_width="@dimen/lb_browse_headers_width"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:visibility="gone" />
        
        <!-- Custom navigation buttons will be added programmatically to browse_frame -->
    </androidx.leanback.widget.BrowseFrameLayout>
</FrameLayout>
